{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order Items Data Contract",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "order_id": { "type": "string", "minLength": 1 },
      "order_item_id": { "type": "integer", "minimum": 1 },
      "product_id": { "type": "string", "minLength": 1 },
      "seller_id": { "type": "string", "minLength": 1 },
      "shipping_limit_date": { "type": ["string", "null"] },
      "price": { "type": "number", "minimum": 0 },
      "freight_value": { "type": "number", "minimum": 0 }
    },
    "required": ["order_id", "order_item_id", "product_id", "seller_id", "price", "freight_value"]
  }
}
