{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Products Data Contract",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "product_id": { "type": "string", "minLength": 1 },
      "product_category_name": { "type": ["string", "null"] },
      "product_weight_g": { "type": ["number", "null"], "minimum": 0 },
      "product_length_cm": { "type": ["number", "null"], "minimum": 0 },
      "product_height_cm": { "type": ["number", "null"], "minimum": 0 },
      "product_width_cm": { "type": ["number", "null"], "minimum": 0 }
    },
    "required": ["product_id"]
  }
}
